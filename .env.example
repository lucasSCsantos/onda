# Valores do Supabase local: rode `pnpm exec supabase status -o env` e copie API_URL e ANON_KEY.
# Em produção, use a URL e a chave pública (anon) do projeto no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor, nunca com o prefixo NEXT_PUBLIC_: a chave service-role ignora as políticas por linha.
# Local: SERVICE_ROLE_KEY de `pnpm exec supabase status -o env`. Em produção, a chave service_role do painel do Supabase.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: consultas por hora que cada endereço de calendário aceita (padrão 60).
# FEED_LIMITE_POR_HORA=60

# Push (ticket 12). Gere as chaves com `scripts/wizard-integracoes.sh` (etapa 9) ou como o README descreve.
# A pública vai ao navegador; a privada fica só no servidor. Rotacionar invalida todas as inscrições.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com.br
# Opcional: 1 = modo de teste (dry-run): o envio só finge que deu certo, nada sai de verdade.
# PUSH_MODO_TESTE=1

# Drive e agendador (pastas dos Eventos): só no servidor. Não são necessários em desenvolvimento, onde os testes usam um
# Drive falso. Em produção, o scripts/wizard-integracoes.sh guia a configuração.
# O JSON da chave da service account do Google, numa linha só.
GOOGLE_SERVICE_ACCOUNT_JSON=
# O segredo que o banco manda ao chamar o agendador (`openssl rand -hex 32`); o mesmo fica no Vault do Supabase (`cron_secret`).
CRON_SECRET=
