# Valores do Supabase local: rode `pnpm exec supabase status -o env` e copie API_URL e ANON_KEY.
# Em produção, use a URL e a chave pública (anon) do projeto no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor, nunca com o prefixo NEXT_PUBLIC_: a chave service-role ignora as políticas por linha.
# Local: SERVICE_ROLE_KEY de `pnpm exec supabase status -o env`. Em produção, a chave service_role do painel do Supabase.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: consultas por hora que cada endereço de calendário aceita (padrão 60).
# FEED_LIMITE_POR_HORA=60
